{
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ],
            "predeploy": [
                "npm --prefix \"$RESOURCE_DIR\" run build"
            ]
        }
    ],
    "hosting": {
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "headers": [
            {
                "source": "/index.html",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/products",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/products/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/mypage",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/mypage/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/login",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/signup",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/cs",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/p/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/search",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/quote-cart",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/notice",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/notice/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/event",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/event/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/review",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/review/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/blank",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/terms",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/privacy",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/admin",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/admin/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "no-cache, no-store, must-revalidate"
                    }
                ]
            },
            {
                "source": "/assets/**",
                "headers": [
                    {
                        "key": "Cache-Control",
                        "value": "public, max-age=31536000, immutable"
                    }
                ]
            }
        ],
        "redirects": [
            {
                "source": "/company",
                "destination": "https://humanpartner.kr/",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture",
                "destination": "/products/%EA%B0%80%EC%A0%84",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture/desk-table",
                "destination": "/products/%EC%82%AC%EB%AC%B4%EA%B0%80%EA%B5%AC/desk-table",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture/chair-sofa",
                "destination": "/products/%EC%82%AC%EB%AC%B4%EA%B0%80%EA%B5%AC/chair-sofa",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture/partition",
                "destination": "/products/%EC%82%AC%EB%AC%B4%EA%B0%80%EA%B5%AC/partition",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture/refrigerator",
                "destination": "/products/%EA%B0%80%EC%A0%84/refrigerator",
                "type": 301
            },
            {
                "source": "/products/appliance-furniture/ac-purifier",
                "destination": "/products/%EA%B0%80%EC%A0%84",
                "type": 301
            },
            {
                "source": "/products/tv",
                "destination": "/products/tv-%EC%9D%8C%ED%96%A5",
                "type": 301
            },
            {
                "source": "/products/tv/video-conference",
                "destination": "/products/tv-%EC%9D%8C%ED%96%A5/video-conference",
                "type": 301
            },
            {
                "source": "/products/lighting",
                "destination": "/products/%ED%96%89%EC%82%AC%EC%9A%A9%ED%92%88/lighting",
                "type": 301
            }
        ],
        "rewrites": [
            {
                "source": "/api/email/verify",
                "function": "sendEmailVerification"
            },
            {
                "source": "/api/admin/quote-email-settings",
                "function": "manageQuoteEmailSettings"
            },
            {
                "source": "/api/email/quote-request-notify",
                "function": "sendQuoteRequestNotification"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    }
}
