                <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto">
                  <XCircle size={32} className="text-red-500" />
                </div>
              )}
              {bookingModal.type === 'info' && (
                <div className="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto">
                  <AlertCircle size={32} className="text-blue-500" />
                </div>
              )}
            </div>
            <p
              className={`text-gray-800 font-semibold whitespace-pre-line mb-8 ${
                bookingModal.variant === "cart"
                  ? "mx-auto max-w-[280px] text-[14.5px] leading-7"
                  : "text-base leading-relaxed"
              }`}
            >
              {bookingModal.message}
            </p>
            {bookingModal.variant === 'cart' ? (
              <div className="grid grid-cols-1 gap-3">
                <button
                  onClick={() => {
                    setBookingModal(prev => ({ ...prev, show: false }));
                  }}
                  className="w-full py-3 rounded-xl border border-slate-300 bg-white text-slate-700 font-semibold hover:bg-slate-50 transition-colors"
                >
                  ?�꾩??蹂닿�?                </button>
                <button
                  onClick={() => {
                    setBookingModal(prev => ({ ...prev, show: false }));
                    navigate('/quote-cart');
                  }}
                  className="w-full py-3 bg-[#001E45] text-white font-semibold rounded-xl hover:bg-[#002D66] transition-colors"
                >
                  ?λ�?��??�濡???��?                </button>
              </div>
            ) : (
              <button
                onClick={() => {
                  setBookingModal(prev => ({ ...prev, show: false }));
                  bookingModal.onClose?.();
                }}
                className="w-full py-3 bg-[#001E45] text-white font-semibold rounded-xl hover:bg-[#002D66] transition-colors"
              >
                ?뺤씤
              </button>
            )}
          </div>
        </div>
      )}
    </>
  );
};
