{
  "name": "rentalpartner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-route-html.cjs",
    "build:functions": "npm --prefix functions run build",
    "check:release": "npm run build && npm run build:functions",
    "preview": "vite preview",
    "deploy:prod": "npm run build && firebase deploy --project humanpartner-mall --only hosting",
    "deploy:prod:functions": "firebase deploy --project humanpartner-mall --only functions:sendEmailVerification,functions:manageQuoteEmailSettings,functions:sendQuoteRequestNotification",
    "deploy:prod:all": "npm run build && firebase deploy --project humanpartner-mall --only hosting,functions:sendEmailVerification,functions:manageQuoteEmailSettings,functions:sendQuoteRequestNotification"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.2",
    "@tanstack/react-query": "^5.100.14",
    "firebase": "^12.8.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-error-boundary": "^6.1.2",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.9",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
